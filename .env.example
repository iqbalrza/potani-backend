# Salin ke .env lalu isi. Jangan commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://potani:potani@localhost:5432/potani
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Auth: firebase (produksi) | dev (token "dev:<uid>", HANYA untuk pengembangan lokal)
AUTH_MODE=firebase
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=

# LLM Groq (kosongkan untuk menjalankan tanpa LLM; endpoint tetap jalan dengan narrative: null)
GROQ_API_KEY=
# llama-3.1-8b-instant (default PRD) sudah tidak tersedia di Groq per Okt 2026.
LLM_MODEL=openai/gpt-oss-20b
# Hanya untuk openai/gpt-oss-*: token penalaran ikut dihitung kuota token per menit.
LLM_REASONING_EFFORT=low
# Saat 429, tunggu sesuai header retry-after maksimal sekian detik, lalu jatuh ke hasil deterministik.
LLM_RATE_LIMIT_WAIT_S=10

# Data domain. crops.json/remediation_rules.json berisi null sampai diisi tim dari sumber.
# Untuk pengembangan pakai file .dev.json (is_demo, BUKAN acuan).
CROPS_FILE=crops.json
REMEDIATION_FILE=remediation_rules.json
SUITABILITY_THRESHOLD=0.5
MAE_PH=0.5
MAE_MOISTURE=5
MAE_TEMPERATURE=1
VERIFY_DELAY_PH_DAYS=56
VERIFY_DELAY_MOISTURE_DAYS=1

# Demo: 1440 = 1 hari disimulasikan dalam 1 menit (56 hari ≈ 56 menit). Tandai mode demo di UI.
TIME_ACCELERATION=1

# MQTT (HiveMQ Cloud)
MQTT_HOST=xxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=potani-mqtt-worker

FCM_ENABLED=false
